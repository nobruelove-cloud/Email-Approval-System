rules_version = '2';

// Deploy this from the Firebase Console → Firestore Database → Rules tab,
// or with `firebase deploy --only firestore:rules` if you use the CLI.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Evaluates whether the authenticated user has role = "admin" in Firestore users/{uid}.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('(?i)^\\s*admin\\s*$');
    }

    // Helper: verifies that a referral claim document is valid for a participant
    function isValidReferralClaim(claimId) {
      return isSignedIn() &&
        request.resource.data.keys().hasAll(['id', 'referralId', 'referrerId', 'referredWorkerId', 'minAcc', 'rewardAmount', 'status']) &&
        (request.auth.uid == request.resource.data.referrerId || request.auth.uid == request.resource.data.referredWorkerId) &&
        exists(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)) &&
        get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)).data.referrerId == request.resource.data.referrerId &&
        get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)).data.referredWorkerId == request.resource.data.referredWorkerId &&
        get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)).data.currentAccCount >= request.resource.data.minAcc &&
        get(/databases/$(database)/documents/referrals/$(request.resource.data.referralId)).data.status != 'REJECTED' &&
        request.resource.data.rewardAmount > 0 &&
        request.resource.data.status == 'approved';
    }

    // Helper: verifies that a balance credit on users/{uid} is backed by a valid referral claim
    function isValidReferralRewardCredit(uid) {
      let delta = request.resource.data.balance - resource.data.balance;
      return delta > 0 &&
        request.resource.data.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.tier == resource.data.tier &&
        (!('email' in resource.data) || request.resource.data.email == resource.data.email) &&
        (!('name' in resource.data) || request.resource.data.name == resource.data.name) &&
        (!('referredBy' in resource.data) || resource.data.referredBy == '' || resource.data.referredBy == null || (!('referredBy' in request.resource.data) || request.resource.data.referredBy == resource.data.referredBy)) &&
        (
          (exists(/databases/$(database)/documents/referrals/$(request.auth.uid)) &&
           getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.referrerId == uid &&
           getAfter(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.rewardAmount == get(/databases/$(database)/documents/referrals/$(request.auth.uid)).data.rewardAmount + delta) ||
          (exists(/databases/$(database)/documents/referrals/$(uid)) &&
           getAfter(/databases/$(database)/documents/referrals/$(uid)).data.referrerId == uid &&
           getAfter(/databases/$(database)/documents/referrals/$(uid)).data.rewardAmount == get(/databases/$(database)/documents/referrals/$(uid)).data.rewardAmount + delta)
        );
    }

    // ---- users/{uid} ----
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      // Self-registration
      allow create: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'status',
          'tier', 'balance', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'referredBy',
          'role', 'status', 'tier', 'balance', 'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        (!('phone' in request.resource.data) ||
          request.resource.data.phone is string) &&
        (!('referredBy' in request.resource.data) ||
          request.resource.data.referredBy is string) &&
        request.resource.data.role == 'worker' &&
        request.resource.data.status == 'active' &&
        request.resource.data.tier == 1 &&
        request.resource.data.balance == 0 &&
        request.resource.data.createdAt is timestamp
      );

      // Self-update (withdrawals / contact info) or referral reward balance credit
      allow update: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.tier == resource.data.tier &&
        (!('referredBy' in resource.data) || resource.data.referredBy == '' || resource.data.referredBy == null || (!('referredBy' in request.resource.data) || request.resource.data.referredBy == resource.data.referredBy)) &&
        request.resource.data.balance >= 0 &&
        request.resource.data.balance <= resource.data.balance
      ) || isValidReferralRewardCredit(uid);

      allow delete: if isAdmin();
    }

    // ---- emailSubmissions/{id} ----
    match /emailSubmissions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- withdrawals/{id} ----
    match /withdrawals/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- settings/{name} ----
    match /settings/{name} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- referrals/{id} ----
    match /referrals/{id} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          id == request.auth.uid ||
          (resource != null && (resource.data.referrerId == request.auth.uid || resource.data.referredWorkerId == request.auth.uid))
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.referrerId == request.auth.uid ||
          resource.data.referredWorkerId == request.auth.uid
        )
      );
      allow create: if isSignedIn() &&
        request.resource.data.referredWorkerId == request.auth.uid &&
        request.resource.data.referrerId != request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.currentAccCount == 0 &&
        request.resource.data.rewardAmount == 0;

      // Allow referral updates during valid claim transactions by referral participants
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource != null &&
        (request.auth.uid == resource.data.referrerId || request.auth.uid == resource.data.referredWorkerId || request.auth.uid == id) &&
        request.resource.data.referrerId == resource.data.referrerId &&
        request.resource.data.referredWorkerId == resource.data.referredWorkerId &&
        request.resource.data.currentAccCount == resource.data.currentAccCount &&
        request.resource.data.rewardAmount >= resource.data.rewardAmount &&
        request.resource.data.status in ['PENDING', 'QUALIFIED', 'PAID'] &&
        (
          request.resource.data.rewardAmount == resource.data.rewardAmount ||
          existsAfter(/databases/$(database)/documents/users/$(resource.data.referrerId))
        ) &&
        (
          request.resource.data.rewardAmount == resource.data.rewardAmount ||
          getAfter(/databases/$(database)/documents/users/$(resource.data.referrerId)).data.balance == get(/databases/$(database)/documents/users/$(resource.data.referrerId)).data.balance + (request.resource.data.rewardAmount - resource.data.rewardAmount)
        )
      );

      allow delete: if isAdmin();
    }

    // ---- referralClaims/{id} ----
    match /referralClaims/{id} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null ||
          resource.data.referrerId == request.auth.uid ||
          resource.data.referredWorkerId == request.auth.uid
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          resource.data.referrerId == request.auth.uid ||
          resource.data.referredWorkerId == request.auth.uid
        )
      );
      allow create, update: if isAdmin() || isValidReferralClaim(id);
      allow delete: if isAdmin();
    }

    // ---- missionClaims/{id} ----
    match /missionClaims/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---- leaderboardPayouts/{id} ----
    match /leaderboardPayouts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- rewardLedger/{id} ----
    match /rewardLedger/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);
      allow create, update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.rewardType == 'referral' &&
        request.resource.data.amount > 0 &&
        existsAfter(/databases/$(database)/documents/referrals/$(request.resource.data.sourceRefId.split('_')[0])) &&
        getAfter(/databases/$(database)/documents/referrals/$(request.resource.data.sourceRefId.split('_')[0])).data.referrerId == request.resource.data.workerId
      );
      allow delete: if isAdmin();
    }

    // ---- financialTransactions/{id} ----
    match /financialTransactions/{id} {
      allow read, write: if isAdmin();
    }
  }
}
