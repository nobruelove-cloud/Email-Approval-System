rules_version = '2';

// Deploy this from the Firebase Console → Firestore Database → Rules tab,
// or with `firebase deploy --only firestore:rules` if you use the CLI.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Evaluates whether the authenticated user has role = "admin" in Firestore users/{uid}.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('(?i)^\\s*admin\\s*$');
    }

    function isValidReferralTierReward(minAcc, rewardAmount) {
      return (minAcc == 5 && rewardAmount == 500) ||
             (minAcc == 10 && rewardAmount == 1000) ||
             (minAcc == 20 && rewardAmount == 2000) ||
             (minAcc == 50 && rewardAmount == 5000) ||
             (
               exists(/databases/$(database)/documents/settings/rules) &&
               ('referralTiers' in get(/databases/$(database)/documents/settings/rules).data) &&
               get(/databases/$(database)/documents/settings/rules).data.referralTiers is list &&
               get(/databases/$(database)/documents/settings/rules).data.referralTiers.exists(t, t.minAcc == minAcc && t.reward == rewardAmount)
             );
    }

    // ---- users/{uid} ----
    match /users/{uid} {
      allow get: if isSignedIn();
      allow list: if isAdmin();

      allow create: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.keys().hasAll([
          'uid', 'name', 'email', 'role', 'status',
          'tier', 'balance', 'createdAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'referredBy',
          'role', 'status', 'tier', 'balance', 'createdAt'
        ]) &&
        request.resource.data.uid == uid &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0 &&
        (!('phone' in request.resource.data) ||
          request.resource.data.phone is string) &&
        (!('referredBy' in request.resource.data) ||
          request.resource.data.referredBy is string) &&
        request.resource.data.role == 'worker' &&
        request.resource.data.status == 'active' &&
        request.resource.data.tier == 1 &&
        request.resource.data.balance == 0 &&
        request.resource.data.createdAt is timestamp
      );

      allow update: if isAdmin() || (
        isSelf(uid) &&
        request.resource.data.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.tier == resource.data.tier &&
        (!('referredBy' in resource.data) || resource.data.referredBy == '' || resource.data.referredBy == null || (!('referredBy' in request.resource.data) || request.resource.data.referredBy == resource.data.referredBy)) &&
        request.resource.data.balance >= 0
      );

      allow delete: if isAdmin();
    }

    // ---- emailSubmissions/{id} ----
    match /emailSubmissions/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'pending';

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- withdrawals/{id} ----
    match /withdrawals/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---- settings/{name} ----
    match /settings/{name} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- referrals/{id} ----
    match /referrals/{id} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          id == request.auth.uid ||
          (resource != null && (
            ('referrerId' in resource.data && resource.data.referrerId == request.auth.uid) ||
            ('referredWorkerId' in resource.data && resource.data.referredWorkerId == request.auth.uid)
          ))
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() && (
          ('referrerId' in resource.data && resource.data.referrerId == request.auth.uid) ||
          ('referredWorkerId' in resource.data && resource.data.referredWorkerId == request.auth.uid)
        )
      );
      allow create: if isSignedIn() &&
        request.resource.data.referredWorkerId == request.auth.uid &&
        request.resource.data.referrerId != request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.currentAccCount == 0 &&
        request.resource.data.rewardAmount == 0;

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource != null &&
        'referrerId' in resource.data &&
        resource.data.referrerId == request.auth.uid &&
        (!('referrerId' in request.resource.data) || request.resource.data.referrerId == resource.data.referrerId) &&
        (!('referredWorkerId' in request.resource.data) || request.resource.data.referredWorkerId == resource.data.referredWorkerId)
      );
      allow delete: if isAdmin();
    }

    // ---- referralClaims/{id} ----
    match /referralClaims/{id} {
      allow get: if isAdmin() || (
        isSignedIn() && (
          resource == null ||
          ('referrerId' in resource.data && resource.data.referrerId == request.auth.uid)
        )
      );
      allow list: if isAdmin() || (
        isSignedIn() &&
        ('referrerId' in resource.data && resource.data.referrerId == request.auth.uid)
      );
      allow create, update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.referrerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ---- missionClaims/{id} ----
    match /missionClaims/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.workerId == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.workerId == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---- leaderboardPayouts/{id} ----
    match /leaderboardPayouts/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- rewardLedger/{id} ----
    match /rewardLedger/{id} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          resource == null ||
          ('workerId' in resource.data && resource.data.workerId == request.auth.uid)
        )
      );
      allow create, update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.workerId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // ---- financialTransactions/{id} ----
    match /financialTransactions/{id} {
      allow read, write: if isAdmin();
    }

    // ---- announcements/{id} ----
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
