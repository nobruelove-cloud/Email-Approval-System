rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(workerUid) {
      return isSignedIn() && request.auth.uid == workerUid;
    }

    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role is string &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role.matches('(?i)^\\s*admin\\s*$');
    }

    function isValidImage() {
      return request.resource == null || (
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp|gif|jpg)')
      );
    }

    // Chat Media Storage: chatMedia/{workerUid}/{messageId}/{fileName}
    match /chatMedia/{workerUid}/{messageId}/{fileName} {
      allow read: if isOwner(workerUid) || isAdmin();
      allow create, update: if (isOwner(workerUid) || isAdmin()) && isValidImage();
      allow delete: if isOwner(workerUid) || isAdmin();
    }

    // Deny access to everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
